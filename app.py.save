from flask import Flask, request
import requests
from openai import OpenAI

app = Flask(__name__)

# 🔑 填你的資料
LINE_TOKEN = "1O2oOqz3rG5OkdVT2OSSQN3FyJuiFeX53iCp2UB3PbgEO93ZMlNDxRsgmcmraqmbxvj5K/x1w/HTP5a+3bVl0VIJmrKJlp5kIUKl7yylpyXzmiXpnBwumrSwYMOAs75nTY3yny5YkGD5rcmfjZRNaQdB04t89/1O/w1cDnyilFU="

client = OpenAI(
    api_key="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",
    base_url="https://openrouter.ai/api/v1"
)

# 🧠 記憶（每個人各自記錄）
user_memory = {}

@app.route("/webhook", methods=['POST'])
def webhook():
    data = request.json

    if 'events' not in data or len(data['events']) == 0:
        return "OK"

    event = data['events'][0]

    if event['type'] != 'message' or event['message']['type'] != 'text':
        return "OK"

    user_msg = event['message']['text']
    reply_token = event['replyToken']
    user_id = event['source']['userId']

    # 初始化記憶
    if user_id not in user_memory:
        user_memory[user_id] = []

    # 🎯 指令區
    if user_msg == "/help":
        ai_reply = "指令：/help /cheap /gpt /reset"

    elif user_msg == "/cheap":
        user_memory[user_id] = []
        ai_reply = "已切換到省錢模式 💸"

    elif user_msg == "/gpt":
        user_memory[user_id] = []
        ai_reply = "已切換到GPT模式 🤖"

    elif user_msg == "/reset":
        user_memory[user_id] = []
        ai_reply = "記憶已清除 🧠"

    else:
        try:
            # 加入使用者訊息
            user_memory[user_id].append({
                "role": "user",
                "content": user_msg
            })

            response = client.chat.completions.create(
                model="openai/gpt-4o-mini",
                messages=user_memory[user_id],
                max_tokens=300
            )

            ai_reply = response.choices[0].message.content

            # 存AI回覆
            user_memory[user_id].append({
                "role": "assistant",
                "content": ai_reply
            })

        except Exception as e:
            ai_reply = "發生錯誤：" + str(e)

    # 回 LINE
    headers = {
        "Authorization": f"Bearer {LINE_TOKEN}",
        "Content-Type": "application/json"
    }

    body = {
        "replyToken": reply_token,
        "messages": [
            {"type": "text", "text": ai_reply}
        ]
    }

    requests.post(
        "https://api.line.me/v2/bot/message/reply",
        headers=headers,
        json=body
    )

    return "OK"


if __name__ == "__main__":
